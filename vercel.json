{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/getGambaLeaderboard.php": { "runtime": "vercel-php@0.7.3" },
    "*.php": { "runtime": "vercel-php@0.7.3" }
  },
  "rewrites": [
    { "source": "/", "destination": "/index.php" },
    { "source": "/duelbits", "destination": "/duelbits.php" },
    { "source": "/gamba", "destination": "/gamba.php" },
    { "source": "/leaderboard", "destination": "/leaderboard.php" },
    { "source": "/giveaways", "destination": "/giveaways.php" },
    { "source": "/rewards", "destination": "/rewards.php" }
  ],
  "redirects": [
    { "source": "/videos", "destination": "/", "permanent": true },
    { "source": "/stream", "destination": "/", "permanent": true },
    { "source": "/index", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/(images|css|js|fonts)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, immutable" }
      ]
    }
  ]
}
