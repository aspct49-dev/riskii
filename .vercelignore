# The admin dashboard needs MySQL and a writable uploads directory, neither of
# which exists on Vercel, and its PHP holds the production database
# credentials. Content lives in includes/content.php instead.
dashboard/

# Apache-only; Vercel routes come from vercel.json.
.htaccess
includes/.htaccess
pages/.htaccess

# Local dev server shim for `php -S`; never used in a deployment.
router.php

# Everything else that is not the site.
xtest/
*.sql
*.log
